{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupret007/webjam/packaging/macos/jamulus-headless-component-evidence.schema.json",
  "title": "Unapproved Jamulus HEADLESS component build evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "version",
    "profile",
    "target",
    "architecture",
    "archive",
    "archive_size",
    "archive_sha256",
    "source_commit",
    "patch_sha256",
    "license_sha256",
    "corresponding_source_sha256",
    "runtime_inventory_sha256",
    "runtime_inventory",
    "activation_approved",
    "catalog_injection_required",
    "catalog_signing_automatic",
    "desktop_release_inventory",
    "legal_gate"
  ],
  "properties": {
    "schema": {"const": 1},
    "component": {"const": "JamulusHeadlessClient"},
    "version": {"const": "3.12.3"},
    "profile": {"const": "r3_12_3"},
    "target": {"enum": ["macos-arm64", "macos-x64"]},
    "architecture": {"enum": ["arm64", "x86_64"]},
    "archive": {
      "pattern": "^JamulusHeadlessClient-r3_12_3-macos-(arm64|x64)-UNAPPROVED-EVIDENCE\\.zip$"
    },
    "archive_size": {"type": "integer", "minimum": 1},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "source_commit": {"const": "74dc422116983a2173eb917cb4d6a403886b31e5"},
    "patch_sha256": {"$ref": "#/$defs/sha256"},
    "license_sha256": {"$ref": "#/$defs/sha256"},
    "corresponding_source_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/file"},
          {"$ref": "#/$defs/symlink"}
        ]
      }
    },
    "activation_approved": {"const": false},
    "catalog_injection_required": {"const": true},
    "catalog_signing_automatic": {"const": false},
    "desktop_release_inventory": {"const": false},
    "legal_gate": {
      "const": "pending-qualified-agpl-13-review-or-protocol-visible-source-offer"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "size", "sha256", "mode"],
      "properties": {
        "kind": {"const": "file"},
        "path": {"$ref": "#/$defs/path"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4095}
      }
    },
    "symlink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "target"],
      "properties": {
        "kind": {"const": "symlink"},
        "path": {"$ref": "#/$defs/path"},
        "target": {"$ref": "#/$defs/path"}
      }
    }
  }
}
