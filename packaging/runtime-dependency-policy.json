    "import": {
      "availability": "runtime-probed",
      "probe": "soundfile.check_format('MP3')"
    },
    "bounce": {
      "availability": "disabled-by-default",
      "bundled_default_adapter": false
    },
    "bundled_standalone_encoder": false
