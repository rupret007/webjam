/*
 * WebJam — one calm, high-contrast system.
 *
 * The only chromatic color is official Longhorn burnt orange.  State is
 * always named in text or controls; color reinforces it but never carries it.
 * Tokens are substituted by qss_loader.py at startup.
 */

/* -------------------------------------------------------------------------
 * Foundations
 * ---------------------------------------------------------------------- */
QWidget {
    background-color: ${COLOR_BG_BASE};
    color: ${COLOR_TEXT_PRIMARY};
    font-family: ${FONT_FAMILY_SANS};
    font-size: ${FONT_SIZE_BASE}px;
}

QMainWindow, QDialog, QWizard, QWizardPage {
    background-color: ${COLOR_BG_BASE};
}

QLabel {
    background-color: transparent;
}

QLabel:disabled, QPushButton:disabled, QToolButton:disabled,
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: ${COLOR_TEXT_MUTED};
}

QPushButton, QToolButton {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
    min-height: 32px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

QPushButton:hover, QToolButton:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
}

QPushButton:focus, QToolButton:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
    outline: none;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: ${COLOR_BG_PANEL};
}

QPushButton:disabled, QToolButton:disabled {
    background-color: ${COLOR_BG_PANEL};
    border-color: ${COLOR_BORDER_SUBTLE};
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_MD}px;
    min-height: 28px;
    selection-background-color: ${COLOR_ACCENT_PRIMARY};
    selection-color: ${COLOR_TEXT_PRIMARY};
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover,
QComboBox:hover, QSpinBox:hover {
    border-color: ${COLOR_TEXT_MUTED};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    selection-background-color: ${COLOR_ACCENT_PRIMARY};
    selection-color: ${COLOR_TEXT_PRIMARY};
    padding: ${SPACE_XS}px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
}

QCheckBox, QRadioButton {
    color: ${COLOR_TEXT_PRIMARY};
    spacing: ${SPACE_SM}px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid ${COLOR_BORDER_STRONG};
    background-color: ${COLOR_BG_INPUT};
}

QCheckBox::indicator {
    border-radius: ${RADIUS_SM}px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover,
QCheckBox:focus, QRadioButton:focus {
    border-color: ${COLOR_BORDER_FOCUS};
}

QCheckBox::indicator:checked {
    background-color: ${COLOR_ACCENT_PRIMARY};
    border-color: ${COLOR_ACCENT_PRIMARY};
}

QRadioButton::indicator:checked {
    background-color: ${COLOR_ACCENT_PRIMARY};
    border: 4px solid ${COLOR_BG_INPUT};
    outline: 1px solid ${COLOR_ACCENT_PRIMARY};
}

/* -------------------------------------------------------------------------
 * Buttons
 * ---------------------------------------------------------------------- */
QPushButton#PrimaryButton, QPushButton#AudioButton {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
    min-height: 34px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

QPushButton#PrimaryButton:hover, QPushButton#AudioButton:hover {
    background-color: ${COLOR_ACCENT_HOVER};
    border-color: ${COLOR_ACCENT_HOVER};
}

QPushButton#PrimaryButton:pressed, QPushButton#AudioButton:pressed {
    background-color: ${COLOR_ACCENT_PRESSED};
    border-color: ${COLOR_ACCENT_PRESSED};
}

QPushButton#PrimaryButton:focus, QPushButton#AudioButton:focus {
    border: 2px solid ${COLOR_TEXT_PRIMARY};
}

QPushButton#PrimaryButton:disabled, QPushButton#AudioButton:disabled {
    background-color: ${COLOR_BG_PANEL};
    color: ${COLOR_TEXT_MUTED};
    border-color: ${COLOR_BORDER_SUBTLE};
}

QPushButton#GhostButton, QToolButton#GhostButton {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
}

QPushButton#GhostButton:hover, QToolButton#GhostButton:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
    border-color: ${COLOR_TEXT_PRIMARY};
}

QPushButton#GhostButton:focus, QToolButton#GhostButton:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

QPushButton#GhostButton:checked, QToolButton#GhostButton:checked {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border-color: ${COLOR_ACCENT_PRIMARY};
}

QPushButton#QuietButton {
    background-color: transparent;
    color: ${COLOR_TEXT_SECONDARY};
    border: 1px solid transparent;
    padding: ${SPACE_SM}px ${SPACE_XS}px;
}

QPushButton#QuietButton:hover {
    color: ${COLOR_TEXT_PRIMARY};
    border-color: ${COLOR_BORDER_STRONG};
    background-color: ${COLOR_BG_CARD_HOVER};
}

QPushButton#QuietButton:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

/* -------------------------------------------------------------------------
 * Session header and meeting controls
 * ---------------------------------------------------------------------- */
#SessionStrip {
    background-color: ${COLOR_BG_PANEL};
    border-bottom: 1px solid ${COLOR_BORDER_SUBTLE};
}

#SessionStripLogo {
    background-color: transparent;
}

#SessionStripTitle {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 2px 0;
    min-height: 24px;
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#SessionStripTitle:focus {
    border: none;
    border-bottom: 2px solid ${COLOR_BORDER_FOCUS};
}

#SessionStripSubtitle {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#SessionTimer {
    color: ${COLOR_TEXT_SECONDARY};
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_MEDIUM};
    padding: 0 ${SPACE_MD}px;
}

#RecordElapsed {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_SM}px;
    padding: 4px 8px;
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#SessionControlBar {
    background-color: ${COLOR_BG_PANEL};
    border-top: 1px solid ${COLOR_BORDER_SUBTLE};
}

#SessionControlBar QPushButton#GhostButton,
#SessionControlBar QToolButton#GhostButton {
    border-radius: 20px;
    min-height: 40px;
    padding: 0 18px;
}

/* The label supplies the one intentional More chevron. Suppress Qt's extra
 * native menu glyph, which otherwise floats below/right of the button. */
#SessionControlBar QToolButton#GhostButton::menu-indicator {
    image: none;
    width: 0px;
}

#SessionControlBar QPushButton#AudioButton[destructive="true"] {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 2px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: 20px;
    min-height: 38px;
    padding: 0 20px;
}

#SessionControlBar QPushButton#AudioButton[destructive="true"]:hover {
    background-color: ${COLOR_ACCENT_PRIMARY};
}

#SessionControlBar QPushButton#AudioButton[destructive="true"]:focus {
    border-color: ${COLOR_TEXT_PRIMARY};
}

/* -------------------------------------------------------------------------
 * Live stage and people
 * ---------------------------------------------------------------------- */
#Stage {
    background-color: ${COLOR_BG_BASE};
}

#StageEmptyState {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_LG}px;
}

#StageEmptyState[sessionState="connecting"],
#StageEmptyState[sessionState="reconnecting"],
#StageEmptyState[sessionState="practice"],
#StageEmptyState[sessionState="permission_required"],
#StageEmptyState[sessionState="permission_denied"],
#StageEmptyState[sessionState="error"] {
    border: 2px solid ${COLOR_ACCENT_PRIMARY};
}

#StageEmptyEyebrow {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: ${FONT_WEIGHT_BOLD};
    letter-spacing: 0.12em;
}

#StageEmptyTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_DISPLAY}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StageEmptyMessage {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_MD}px;
}

#StageEmptyHint {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
    padding-top: ${SPACE_XS}px;
}

#ParticipantCard {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_LG}px;
}

#ParticipantCard[connected="false"] {
    border: 2px dashed ${COLOR_BORDER_STRONG};
}

#ParticipantCard[local="true"] {
    border: 2px solid ${COLOR_TEXT_MUTED};
}

#ParticipantCard[speaking="true"],
#ParticipantCard[local="true"][speaking="true"] {
    border: 3px solid ${COLOR_ACCENT_PRIMARY};
}

#ParticipantCard[muted="true"],
#ParticipantCard[muted="true"] #ParticipantCardBody {
    background-color: ${COLOR_BG_PANEL};
}

#ParticipantCard[muted="true"] #ParticipantName,
#ParticipantCard[muted="true"] #ParticipantRole {
    color: ${COLOR_TEXT_MUTED};
}

#VideoTile {
    background-color: ${COLOR_BG_PANEL};
    border-top-left-radius: ${RADIUS_LG}px;
    border-top-right-radius: ${RADIUS_LG}px;
    border-bottom: 1px solid ${COLOR_BORDER_SUBTLE};
}

#ParticipantCardBody {
    background-color: ${COLOR_BG_CARD};
    border-bottom-left-radius: ${RADIUS_LG}px;
    border-bottom-right-radius: ${RADIUS_LG}px;
}

QLabel#ParticipantAvatar {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border: 2px solid ${COLOR_TEXT_PRIMARY};
    border-radius: 32px;
    font-size: 18px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#ParticipantName {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#ParticipantRole, #FaderValue, QLabel#BodyLabel, #VideoPlaceholder {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#FaderValue {
    font-family: ${FONT_FAMILY_MONO};
}

QPushButton#PillButton {
    min-height: 32px;
    border-radius: 17px;
    padding: 0 ${SPACE_LG}px;
}

QPushButton#PillButton[state="active-mute"] {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border-color: ${COLOR_ACCENT_PRIMARY};
}

QPushButton#PillButton[state="active-solo"] {
    background-color: ${COLOR_BG_PANEL};
    color: ${COLOR_TEXT_PRIMARY};
    border: 2px solid ${COLOR_ACCENT_PRIMARY};
}

QPushButton#PillButton:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

/* -------------------------------------------------------------------------
 * Sliders and meters
 * ---------------------------------------------------------------------- */
QSlider {
    min-height: 28px;
}

QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background-color: ${COLOR_BORDER_STRONG};
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: ${COLOR_ACCENT_PRIMARY};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: ${COLOR_ACCENT_PRIMARY};
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
    border: 2px solid ${COLOR_TEXT_PRIMARY};
}

QSlider::handle:horizontal:hover {
    background-color: ${COLOR_ACCENT_HOVER};
}

QSlider:focus {
    border: 1px solid ${COLOR_BORDER_FOCUS};
    border-radius: ${RADIUS_SM}px;
}

/* -------------------------------------------------------------------------
 * Session truth, notes, and optional tools
 * ---------------------------------------------------------------------- */
#SessionHud {
    background-color: ${COLOR_BG_PANEL};
    border-bottom: 1px solid ${COLOR_BORDER_SUBTLE};
    min-height: 56px;
}

#SessionHud[ready="true"] {
    border-bottom: 2px solid ${COLOR_ACCENT_PRIMARY};
}

#SessionHudStatus {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#SessionHudDetail {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#SessionCanvas {
    background-color: ${COLOR_BG_PANEL};
    border-left: 1px solid ${COLOR_BORDER_SUBTLE};
}

#CanvasHeader {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: ${FONT_WEIGHT_BOLD};
    letter-spacing: 0.08em;
    padding: ${SPACE_MD}px ${SPACE_LG}px ${SPACE_SM}px ${SPACE_LG}px;
}

#CanvasNotes {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
}

QLineEdit#CanvasChatInput {
    border-radius: ${RADIUS_PILL}px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
}

#SessionPulse, #MusicianGuidance {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    margin: 0 ${SPACE_MD}px;
}

#MusicianGuidance {
    border-left: 3px solid ${COLOR_ACCENT_PRIMARY};
}

#SessionPulse {
    border-left: 3px solid ${COLOR_BORDER_STRONG};
}

#PulseHeader, #PulseSignals, #GuidanceWhy, #GuidanceRecent {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
}

#PulseStage, #PulseNext, #PulseSummary, #GuidanceNext, #GuidanceOutputs {
    color: ${COLOR_TEXT_PRIMARY};
}

#PulseStage, #PulseNext, #GuidanceNext {
    font-weight: ${FONT_WEIGHT_BOLD};
}

#WebexEmbed {
    background-color: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
}

#WebexPlaceholder {
    background-color: transparent;
}

#WebexEmbedTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#WebexStatusLabel {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
}

/* -------------------------------------------------------------------------
 * Host / Join launch
 * ---------------------------------------------------------------------- */
#LaunchDialog {
    background-color: ${COLOR_BG_BASE};
}

#JamSignalGraphic {
    background-color: transparent;
}

#LaunchLogo {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: 22px;
    font-weight: ${FONT_WEIGHT_BOLD};
    letter-spacing: 0.02em;
}

#LaunchTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: 36px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#LaunchSubtitle {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_MD}px;
}

#LaunchHelper {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
    padding-top: ${SPACE_XS}px;
}

QPushButton#LaunchPrimary {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    min-height: 52px;
    padding: 0 ${SPACE_XL}px;
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

QPushButton#LaunchPrimary:hover {
    background-color: ${COLOR_ACCENT_HOVER};
    border-color: ${COLOR_ACCENT_HOVER};
}

QPushButton#LaunchPrimary:pressed {
    background-color: ${COLOR_ACCENT_PRESSED};
    border-color: ${COLOR_ACCENT_PRESSED};
}

QPushButton#LaunchPrimary:focus {
    border: 2px solid ${COLOR_TEXT_PRIMARY};
}

QPushButton#LaunchPrimary:disabled {
    background-color: ${COLOR_BG_PANEL};
    color: ${COLOR_TEXT_MUTED};
    border-color: ${COLOR_BORDER_SUBTLE};
}

QPushButton#LaunchSecondary {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    min-height: 52px;
    padding: 0 ${SPACE_XL}px;
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

QPushButton#LaunchSecondary:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
    border-color: ${COLOR_TEXT_PRIMARY};
}

QPushButton#LaunchSecondary:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

#LaunchInviteInput {
    min-height: 46px;
    padding: 0 ${SPACE_LG}px;
    font-size: ${FONT_SIZE_BASE}px;
}

#LaunchError {
    color: ${COLOR_TEXT_PRIMARY};
    min-height: 20px;
    font-size: ${FONT_SIZE_SM}px;
}

/* -------------------------------------------------------------------------
 * Band Check and settings
 * ---------------------------------------------------------------------- */
#BandCheckDialog {
    background-color: ${COLOR_BG_BASE};
}

#BandCheckEyebrow {
    color: ${COLOR_ACCENT_PRIMARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#BandCheckTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_XL}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#BandCheckIntro, #BandCheckNext {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_BASE}px;
}

#BandCheckNext {
    color: ${COLOR_TEXT_PRIMARY};
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#BandCheckMeter {
    min-height: 24px;
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_INPUT};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_SM}px;
    text-align: center;
}

#BandCheckMeter::chunk {
    background-color: ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_SM}px;
}

#ReadySummary {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#ReadySummary[result="pass"], #ReadySummary[result="fail"] {
    border-color: ${COLOR_ACCENT_PRIMARY};
}

#ReadyCheckRow {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-left: 4px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
}

#ReadyCheckRow:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

#ReadyCheckMark {
    min-width: 62px;
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#ReadyCheckName {
    color: ${COLOR_TEXT_PRIMARY};
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#ReadyCheckDetail {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#SupportBundlePreviewDialog {
    background-color: ${COLOR_BG_BASE};
}

#SupportPreviewEyebrow {
    color: ${COLOR_ACCENT_PRIMARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#SupportPreviewTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_XL}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#SupportPreviewPrivacy {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#SupportPreviewSummary, #SupportPreviewFile {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#SupportPreviewSectionTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#SupportPreviewFiles, #SupportPreviewReport {
    color: ${COLOR_TEXT_SECONDARY};
    background-color: ${COLOR_BG_INPUT};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_SM}px;
}

#SupportPreviewReport {
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
    padding: ${SPACE_SM}px;
}

#SimpleSettingsDialog, #RecordingSetupDialog, #FirstRunSetupDialog {
    background-color: ${COLOR_BG_BASE};
}

#SimpleSettingsTitle, #FirstRunTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_XL}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#SimpleSettingsSubtitle, #FirstRunSubtitle {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_BASE}px;
}

#SimpleSettingsRole, #FirstRunStatus, #FirstRunSignalFlow,
#SimpleSettingsNote {
    color: ${COLOR_TEXT_SECONDARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-left: 3px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
}

#SimpleSettingsFieldLabel, #FirstRunFieldLabel {
    color: ${COLOR_TEXT_PRIMARY};
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

#SimpleSettingsSection {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
}

#SimpleSettingsSectionTitle {
    color: ${COLOR_ACCENT_PRIMARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
    text-transform: uppercase;
}

#SimpleSettingsHint {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

QToolButton#SimpleSettingsDisclosure {
    background-color: transparent;
    color: ${COLOR_TEXT_PRIMARY};
    border: 0;
    padding: 0;
    min-height: 20px;
    text-align: left;
}

QToolButton#SimpleSettingsDisclosure:hover {
    color: ${COLOR_ACCENT_PRIMARY};
    background-color: transparent;
}

QToolButton#SimpleSettingsDisclosure:focus {
    border: 1px solid ${COLOR_BORDER_FOCUS};
}

QLabel#SimpleSettingsError, QLabel#FirstRunError, QLabel#WizardError {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_SM}px;
    padding: ${SPACE_SM}px ${SPACE_MD}px;
}

#FirstRunProgress {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px ${SPACE_MD}px;
    font-size: ${FONT_SIZE_SM}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

QCommandLinkButton#FirstRunRoleCard, QCommandLinkButton#SimpleRoleCard {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
    text-align: left;
}

QCommandLinkButton#FirstRunRoleCard:hover,
QCommandLinkButton#SimpleRoleCard:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
}

QCommandLinkButton#FirstRunRoleCard:checked,
QCommandLinkButton#FirstRunRoleCard:focus,
QCommandLinkButton#SimpleRoleCard:checked,
QCommandLinkButton#SimpleRoleCard:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

QWizard QPushButton:default, QMessageBox QPushButton:default {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border-color: ${COLOR_ACCENT_PRIMARY};
}

/* -------------------------------------------------------------------------
 * Multitrack Studio
 * ---------------------------------------------------------------------- */
#RecordingStudio {
    background-color: ${COLOR_BG_BASE};
}

#StudioEyebrow {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
    letter-spacing: 0.14em;
}

#StudioTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: 28px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StudioSubtitle, #StudioTrackDetail, #StudioPosition {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#StudioPhase {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_MD}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

QPushButton#StudioRecordButton {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_ACCENT_PRIMARY};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
    border-radius: ${RADIUS_MD}px;
    min-height: 36px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

QPushButton#StudioRecordButton:hover {
    background-color: ${COLOR_ACCENT_HOVER};
}

QPushButton#StudioRecordButton:focus {
    border: 2px solid ${COLOR_TEXT_PRIMARY};
}

#StudioLibrary, #StudioEditor {
    background-color: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
}

#StudioSectionTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StudioTakeList {
    background-color: ${COLOR_BG_INPUT};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px;
    outline: none;
}

#StudioTakeList::item {
    color: ${COLOR_TEXT_SECONDARY};
    border-radius: ${RADIUS_SM}px;
    padding: ${SPACE_SM}px;
    margin: 2px;
}

#StudioTakeList::item:selected {
    color: ${COLOR_TEXT_PRIMARY};
    background-color: ${COLOR_BG_CARD_HOVER};
    border-left: 3px solid ${COLOR_ACCENT_PRIMARY};
}

#StudioTrackScroll {
    background-color: transparent;
}

#StudioTimelineGutter {
    color: ${COLOR_TEXT_MUTED};
    background-color: ${COLOR_BG_INPUT};
    border-bottom: 1px solid ${COLOR_BORDER_SUBTLE};
    padding-left: ${SPACE_SM}px;
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
    letter-spacing: 0.1em;
}

#StudioTrackLane {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
}

#StudioTrackLane[selected="true"] {
    background-color: ${COLOR_BG_CARD_HOVER};
    border: 1px solid ${COLOR_ACCENT_PRIMARY};
}

#StudioTrackHeader {
    background-color: ${COLOR_BG_PANEL};
    border: none;
    border-radius: ${RADIUS_SM}px;
}

#StudioTrackNumber {
    color: ${COLOR_ACCENT_PRIMARY};
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StudioTrackName {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_BASE}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StudioTrackSource {
    color: ${COLOR_TEXT_SECONDARY};
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: 3px;
    padding: 1px 4px;
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StudioGainValue, #StudioPanValue {
    color: ${COLOR_TEXT_SECONDARY};
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
}

QCheckBox#StudioTrackExportInclude {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_XS}px;
    spacing: 3px;
}

QCheckBox#StudioTrackExportInclude::indicator {
    width: 11px;
    height: 11px;
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: 2px;
    background-color: ${COLOR_BG_INPUT};
}

QCheckBox#StudioTrackExportInclude::indicator:checked {
    background-color: ${COLOR_ACCENT_PRIMARY};
    border-color: ${COLOR_ACCENT_PRIMARY};
}

QPushButton#StudioMuteButton, QPushButton#StudioSoloButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0;
    border-radius: ${RADIUS_SM}px;
}

QPushButton#StudioMuteButton:checked,
QPushButton#StudioSoloButton:checked {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
    border-color: ${COLOR_ACCENT_PRIMARY};
}

#StudioRuler {
    color: ${COLOR_TEXT_MUTED};
    background-color: ${COLOR_BG_INPUT};
    border-bottom: 1px solid ${COLOR_BORDER_SUBTLE};
    padding: ${SPACE_XS}px ${SPACE_SM}px;
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
}

#StudioInspector {
    background-color: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
}

#StudioInspectorTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_BOLD};
}

#StudioInspectorField {
    color: ${COLOR_TEXT_MUTED};
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: ${FONT_WEIGHT_BOLD};
    letter-spacing: 0.08em;
}

#StudioInspectorValue {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#StudioHint {
    color: ${COLOR_TEXT_SECONDARY};
    background-color: ${COLOR_BG_CARD};
    border-radius: ${RADIUS_SM}px;
    padding: ${SPACE_SM}px;
}

#StudioHint[compact="true"] {
    padding: 0 ${SPACE_XS}px;
}

#StudioPanValue {
    color: ${COLOR_TEXT_SECONDARY};
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_XS}px;
}

QComboBox#StudioOutputPicker {
    min-width: 140px;
    max-width: 220px;
}

/* -------------------------------------------------------------------------
 * Lists, menus, tooltips, status, and legacy Take Deck
 * ---------------------------------------------------------------------- */
QListWidget {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px;
}

QListWidget::item {
    padding: ${SPACE_SM}px ${SPACE_MD}px;
    border-radius: ${RADIUS_SM}px;
}

QListWidget::item:selected {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
}

QListWidget::item:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
}

QMenu {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px;
}

QMenu::item {
    background-color: transparent;
    padding: ${SPACE_SM}px ${SPACE_XL}px ${SPACE_SM}px ${SPACE_MD}px;
    border-radius: ${RADIUS_SM}px;
}

QMenu::item:selected {
    background-color: ${COLOR_ACCENT_PRIMARY};
    color: ${COLOR_TEXT_PRIMARY};
}

QMenu::item:disabled {
    color: ${COLOR_TEXT_MUTED};
}

QMenu::separator {
    height: 1px;
    background-color: ${COLOR_BORDER_SUBTLE};
    margin: ${SPACE_XS}px ${SPACE_SM}px;
}

QToolTip {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    padding: ${SPACE_XS}px ${SPACE_SM}px;
}

QStatusBar {
    background-color: ${COLOR_BG_PANEL};
    color: ${COLOR_TEXT_SECONDARY};
    border-top: 1px solid ${COLOR_BORDER_SUBTLE};
    font-size: ${FONT_SIZE_SM}px;
}

QStatusBar::item {
    border: none;
}

#TakeDeck {
    background-color: ${COLOR_BG_BASE};
}

QListWidget#TakeList {
    background-color: ${COLOR_BG_INPUT};
    border: 1px solid ${COLOR_BORDER_STRONG};
}

QLabel#TakeTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: ${FONT_WEIGHT_SEMIBOLD};
}

QLabel#TakeHint {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
}

/* -------------------------------------------------------------------------
 * Navigation and scrollbars
 * ---------------------------------------------------------------------- */
#SideRail {
    background-color: ${COLOR_BG_PANEL};
    border-right: 1px solid ${COLOR_BORDER_SUBTLE};
}

QToolButton#SideRailButton {
    background-color: transparent;
    color: ${COLOR_TEXT_SECONDARY};
    border: none;
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px;
    min-width: 44px;
    min-height: 44px;
    font-size: ${FONT_SIZE_SM}px;
}

QToolButton#SideRailButton:hover {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
}

QToolButton#SideRailButton:checked {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border-left: 3px solid ${COLOR_ACCENT_PRIMARY};
}

QToolButton#SideRailButton:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: ${COLOR_BORDER_STRONG};
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: ${COLOR_TEXT_MUTED};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: ${COLOR_BORDER_STRONG};
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
    width: 0;
}
