/*
 * Conductor stylesheet.
 *
 * Tokens are substituted at load time by qss_loader.py.
 * Reference: ${COLOR_BG_BASE}, ${SPACE_MD}, ${RADIUS_MD}, etc.
 */

/* ============================================================
 * Global
 * ============================================================ */
QWidget {
    background-color: ${COLOR_BG_BASE};
    color: ${COLOR_TEXT_PRIMARY};
    font-family: ${FONT_FAMILY_SANS};
    font-size: ${FONT_SIZE_BASE}px;
}

QLabel {
    background-color: transparent;
}

QMainWindow, QDialog {
    background-color: ${COLOR_BG_BASE};
}

/* ============================================================
 * Session Strip (top bar)
 * ============================================================ */
#SessionStrip {
    background-color: ${COLOR_BG_PANEL};
    border-bottom: 1px solid ${COLOR_BORDER_SUBTLE};
}

#SessionStripLogo {
    color: ${COLOR_ACCENT_VIDEO};
    font-size: ${FONT_SIZE_LG}px;
    font-weight: 700;
    padding: 0 ${SPACE_SM}px;
}

#SessionStripTitle {
    font-size: ${FONT_SIZE_MD}px;
    font-weight: 600;
    color: ${COLOR_TEXT_PRIMARY};
}

#SessionStripSubtitle {
    font-size: ${FONT_SIZE_SM}px;
    color: ${COLOR_TEXT_SECONDARY};
}

#SessionTimer {
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_LG}px;
    font-weight: 500;
    color: ${COLOR_TEXT_PRIMARY};
    padding: 0 ${SPACE_MD}px;
}

#RecordElapsed {
    color: ${COLOR_ACCENT_RECORD};
    font-family: ${FONT_FAMILY_MONO};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 700;
    padding: 3px 7px;
    border: 1px solid ${COLOR_ACCENT_RECORD};
    border-radius: ${RADIUS_SM}px;
}

/* ============================================================
 * Side Rail (left)
 * ============================================================ */
#SideRail {
    background-color: ${COLOR_BG_PANEL};
    border-right: 1px solid ${COLOR_BORDER_SUBTLE};
}

QToolButton#SideRailButton {
    background-color: transparent;
    color: ${COLOR_TEXT_SECONDARY};
    border: none;
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px;
    min-width: 44px;
    min-height: 44px;
    font-size: ${FONT_SIZE_SM}px;
}

QToolButton#SideRailButton:hover {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
}

QToolButton#SideRailButton:checked {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_ACCENT_VIDEO};
    border-left: 2px solid ${COLOR_ACCENT_VIDEO};
}

QToolButton#SideRailButton[utility="true"] {
    color: ${COLOR_TEXT_MUTED};
}

QToolButton#SideRailButton:focus {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 2px solid ${COLOR_ACCENT_VIDEO};   /* was 1px — too subtle for keyboard nav */
    outline: none;
}

/* ============================================================
 * Participant Grid / Stage
 * ============================================================ */
#Stage {
    background-color: ${COLOR_BG_BASE};
}

#StageEmptyState {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_LG}px;
}

#StageEmptyState[sessionState="connecting"],
#StageEmptyState[sessionState="reconnecting"],
#StageEmptyState[sessionState="practice"] {
    border: 1px solid ${COLOR_ACCENT_AUDIO};
}

#StageEmptyEyebrow {
    color: ${COLOR_ACCENT_AUDIO};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 700;
    letter-spacing: 0.12em;
}

#StageEmptyTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_DISPLAY}px;
    font-weight: 700;
}

#StageEmptyMessage {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_MD}px;
}

#StageEmptyHint {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
    font-family: ${FONT_FAMILY_MONO};
    padding-top: ${SPACE_SM}px;
}

/* ============================================================
 * Participant Card
 * ============================================================ */
#ParticipantCard {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_LG}px;
}

#ParticipantCard[connected="false"] {
    border: 1px dashed ${COLOR_BORDER_STRONG};
}

#ParticipantCard[muted="true"] {
    background-color: ${COLOR_BG_INPUT};   /* slightly darker than card bg → visually fades */
}

#ParticipantCard[muted="true"] #ParticipantName,
#ParticipantCard[muted="true"] #ParticipantRole {
    color: ${COLOR_TEXT_MUTED};
}

#ParticipantCard[local="true"] {
    border: 1px solid ${COLOR_ACCENT_AUDIO};  /* gold highlight — this is you */
}

#ParticipantCard[speaking="true"] {
    border: 2px solid ${COLOR_ACCENT_AUDIO};
}

#ParticipantCard[local="true"][speaking="true"] {
    border: 2px solid ${COLOR_ACCENT_AUDIO};
}

/* Thin accent bar at the top of each participant card.
 * Per-channel video isn't implemented yet; the bar is purely visual.
 * When per-channel video lands, the tile will grow back into a video
 * surface and the rounded corners can be enlarged again. */
#VideoTile {
    background-color: ${COLOR_ACCENT_VIDEO};
    border-top-left-radius: ${RADIUS_LG}px;
    border-top-right-radius: ${RADIUS_LG}px;
}

#ParticipantCard[local="true"] #VideoTile {
    background-color: ${COLOR_ACCENT_AUDIO};  /* gold accent for the local user */
}

#VideoPlaceholder {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
}

#ParticipantName {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: 600;
}

#ParticipantRole {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

#FaderValue {
    font-family: ${FONT_FAMILY_MONO};
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

QLabel#BodyLabel {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

/* ============================================================
 * Mute / Solo pills
 * ============================================================ */
QPushButton#PillButton {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_SECONDARY};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_PILL}px;
    padding: ${SPACE_XS}px ${SPACE_MD}px;
    font-weight: 600;
    font-size: ${FONT_SIZE_SM}px;
    min-height: 22px;
}

QPushButton#PillButton:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
    color: ${COLOR_TEXT_PRIMARY};
}

QPushButton#PillButton[state="active-mute"] {
    background-color: ${COLOR_ACCENT_DANGER};
    color: ${COLOR_TEXT_INVERSE};
    border: 1px solid ${COLOR_ACCENT_DANGER};
}

QPushButton#PillButton[state="active-solo"] {
    background-color: ${COLOR_ACCENT_AUDIO};
    color: ${COLOR_TEXT_INVERSE};
    border: 1px solid ${COLOR_ACCENT_AUDIO};
}

QPushButton#PillButton:focus {
    background-color: ${COLOR_BG_CARD_HOVER};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_ACCENT_VIDEO};
    outline: none;
}

QPushButton#PillButton[state="active-mute"]:focus {
    border: 1px solid ${COLOR_ACCENT_VIDEO};
    outline: none;
}

QPushButton#PillButton[state="active-solo"]:focus {
    border: 1px solid ${COLOR_ACCENT_VIDEO};
    outline: none;
}

QPushButton#PillButton:disabled {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_MUTED};
    border: 1px solid transparent;
}

/* ============================================================
 * Primary buttons (Launch Jamulus / Join Webex)
 * ============================================================ */
QPushButton#PrimaryButton {
    background-color: ${COLOR_ACCENT_VIDEO};
    color: ${COLOR_TEXT_INVERSE};
    border: none;
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
    font-weight: 600;
    font-size: ${FONT_SIZE_BASE}px;
}

QPushButton#PrimaryButton:hover {
    background-color: #5EE5E5;
}

QPushButton#PrimaryButton:focus {
    border: 1px solid ${COLOR_ACCENT_VIDEO};
    outline: none;
}

QPushButton#PrimaryButton:pressed {
    background-color: #2DB5B5;
}

QPushButton#PrimaryButton:disabled {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_MUTED};
    border: 1px solid transparent;
}

QPushButton#AudioButton {
    background-color: ${COLOR_ACCENT_AUDIO};
    color: ${COLOR_TEXT_INVERSE};
    border: none;
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
    font-weight: 600;
    font-size: ${FONT_SIZE_BASE}px;
}

QPushButton#AudioButton:hover {
    background-color: #F7BD62;
}

QPushButton#AudioButton:focus {
    border: 1px solid ${COLOR_ACCENT_AUDIO};
    outline: none;
}

QPushButton#AudioButton:pressed {
    background-color: #C8800A;
}

QPushButton#AudioButton:disabled {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_MUTED};
    border: 1px solid transparent;
}

QPushButton#GhostButton, QToolButton#GhostButton {
    background-color: transparent;
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_SM}px ${SPACE_LG}px;
    font-weight: 500;
}

QPushButton#GhostButton:hover, QToolButton#GhostButton:hover {
    background-color: ${COLOR_BG_CARD};
    border-color: ${COLOR_ACCENT_VIDEO};
}

QPushButton#GhostButton:focus, QToolButton#GhostButton:focus {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_ACCENT_VIDEO};
    outline: none;
}

QPushButton#GhostButton:disabled, QToolButton#GhostButton:disabled {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_MUTED};
    border: 1px solid transparent;
}

/* When a ghost button is checkable and checked (e.g. 'Resume Music' after
 * starting a Talk Break), paint it in the danger accent so the muted-self
 * state is obvious at a glance. */
QPushButton#GhostButton:checked, QToolButton#GhostButton:checked {
    background-color: ${COLOR_ACCENT_DANGER};
    color: ${COLOR_TEXT_INVERSE};
    border: 1px solid ${COLOR_ACCENT_DANGER};
}

QPushButton#GhostButton:checked:hover, QToolButton#GhostButton:checked:hover {
    background-color: #F26A7F;
}

/* ============================================================
 * Status Bar
 * ============================================================ */
QStatusBar {
    background-color: ${COLOR_BG_PANEL};
    color: ${COLOR_TEXT_SECONDARY};
    border-top: 1px solid ${COLOR_BORDER_SUBTLE};
    font-size: ${FONT_SIZE_SM}px;
}

QStatusBar::item {
    border: none;
}

/* ============================================================
 * Faders (QSlider)
 * ============================================================ */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: ${COLOR_BG_INPUT};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: ${COLOR_ACCENT_AUDIO};
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    border: 2px solid ${COLOR_BG_CARD};
}

QSlider::handle:horizontal:hover {
    background: #F7BD62;
}

QSlider::handle:horizontal:focus {
    border: 2px solid ${COLOR_ACCENT_AUDIO};
}

QSlider::sub-page:horizontal {
    background: ${COLOR_ACCENT_AUDIO};
    border-radius: 3px;
}

/* ============================================================
 * Session Canvas (right-side notes panel)
 * ============================================================ */
#SessionCanvas {
    background-color: ${COLOR_BG_PANEL};
    border-left: 1px solid ${COLOR_BORDER_SUBTLE};
}

#CanvasHeader {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: ${SPACE_MD}px ${SPACE_LG}px ${SPACE_SM}px ${SPACE_LG}px;
}

#CanvasNotes {
    background-color: ${COLOR_BG_INPUT};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
    color: ${COLOR_TEXT_PRIMARY};
    font-family: ${FONT_FAMILY_SANS};
    font-size: ${FONT_SIZE_BASE}px;
    selection-background-color: ${COLOR_ACCENT_VIDEO};
    selection-color: ${COLOR_TEXT_INVERSE};
}

#CanvasNotes:focus {
    border: 1px solid ${COLOR_BORDER_FOCUS};
}

/* ============================================================
 * Webex placeholder pane (Phase 3 will replace with QWebEngineView)
 * ============================================================ */
QWidget#WebexPlaceholder {
    background: transparent;
}

#WebexEmbed {
    background-color: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    color: ${COLOR_TEXT_SECONDARY};
}

#WebexEmbedTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: 600;
}

#WebexStatusLabel {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
}

/* ============================================================
 * Misc — ComboBox, LineEdit
 * ============================================================ */
QComboBox {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px ${SPACE_MD}px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: ${COLOR_BORDER_STRONG};
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    selection-background-color: ${COLOR_ACCENT_VIDEO};
    selection-color: ${COLOR_TEXT_INVERSE};
    padding: ${SPACE_XS}px;
}

QLineEdit {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px ${SPACE_MD}px;
}

QLineEdit:focus {
    border: 1px solid ${COLOR_BORDER_FOCUS};
}

/* ============================================================
 * Scrollbars — subtle, dark
 * ============================================================ */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: ${COLOR_BORDER_STRONG};
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: ${COLOR_TEXT_MUTED};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: ${COLOR_BORDER_STRONG};
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* ============================================================
 * Session Pulse — local note-derived session structure
 * ============================================================ */
QFrame#SessionPulse {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    margin: 0 ${SPACE_MD}px;
}

QLabel#PulseHeader {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: 600;
}

QLabel#PulseStage {
    color: ${COLOR_ACCENT_AUDIO};
    font-size: ${FONT_SIZE_MD}px;
    font-weight: 700;
}

QLabel#PulseSummary {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_SM}px;
}

QLabel#PulseNext {
    color: ${COLOR_ACCENT_VIDEO};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 600;
}

QLabel#PulseSignals {
    color: ${COLOR_TEXT_MUTED};
    font-size: ${FONT_SIZE_SM}px;
}

/* ============================================================
 * Ready Check — structured pre-jam results
 * ============================================================ */
QLabel#ReadySummary {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_MD}px;
    font-size: ${FONT_SIZE_MD}px;
    font-weight: 700;
}

QLabel#ReadySummary[result="pass"] {
    border-color: ${COLOR_ACCENT_SUCCESS};
    color: ${COLOR_ACCENT_SUCCESS};
}

QLabel#ReadySummary[result="fail"] {
    border-color: ${COLOR_ACCENT_DANGER};
    color: ${COLOR_TEXT_PRIMARY};
}

QFrame#ReadyCheckRow {
    background-color: ${COLOR_BG_CARD};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
}

QFrame#ReadyCheckRow:focus {
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

QFrame#ReadyCheckRow[result="fail"] {
    border-left: 4px solid ${COLOR_ACCENT_DANGER};
}

QFrame#ReadyCheckRow[result="warn"] {
    border-left: 4px solid ${COLOR_ACCENT_WARN};
}

QFrame#ReadyCheckRow[result="pass"] {
    border-left: 4px solid ${COLOR_ACCENT_SUCCESS};
}

QFrame#ReadyCheckRow[result="verify"] {
    border-left: 4px solid ${COLOR_ACCENT_VIDEO};
}

QLabel#ReadyCheckMark, QCheckBox#ReadyCheckMark {
    min-width: 62px;
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_XS}px;
    font-weight: 700;
}

QCheckBox#ReadyCheckMark:focus {
    color: ${COLOR_TEXT_PRIMARY};
}

QLabel#ReadyCheckName {
    color: ${COLOR_TEXT_PRIMARY};
    font-weight: 600;
}

QLabel#ReadyCheckDetail {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_SM}px;
}

/* ── Focused first-run setup ─────────────────────────────────────────── */
QDialog#FirstRunSetupDialog {
    background: ${COLOR_BG_BASE};
}

QLabel#FirstRunTitle {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_XL}px;
    font-weight: 700;
}

QLabel#FirstRunSubtitle {
    color: ${COLOR_TEXT_SECONDARY};
    font-size: ${FONT_SIZE_BASE}px;
}

QLabel#FirstRunProgress {
    color: ${COLOR_ACCENT_VIDEO};
    background: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: 11px;
    padding: 4px 10px;
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 600;
}

QCommandLinkButton#FirstRunRoleCard {
    color: ${COLOR_TEXT_PRIMARY};
    background: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: 10px 14px;
    text-align: left;
}

QCommandLinkButton#FirstRunRoleCard:hover {
    background: ${COLOR_BG_CARD};
    border-color: ${COLOR_TEXT_MUTED};
}

QCommandLinkButton#FirstRunRoleCard:checked,
QCommandLinkButton#FirstRunRoleCard:focus {
    background: rgba(61, 211, 211, 0.10);
    border: 2px solid ${COLOR_BORDER_FOCUS};
}

QCommandLinkButton#FirstRunRoleCard:disabled {
    color: ${COLOR_TEXT_MUTED};
    background: ${COLOR_BG_INPUT};
}

QLabel#FirstRunFieldLabel {
    color: ${COLOR_TEXT_PRIMARY};
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 600;
}

QLabel#FirstRunBody {
    color: ${COLOR_TEXT_SECONDARY};
}

QLabel#FirstRunStatus {
    color: ${COLOR_TEXT_SECONDARY};
    background: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_SM}px;
    padding: 8px 10px;
}

QLabel#FirstRunError {
    color: ${COLOR_ACCENT_WARN};
    min-height: 16px;
}

QLabel#FirstRunSignalFlow {
    color: ${COLOR_TEXT_SECONDARY};
    background: ${COLOR_BG_PANEL};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_SM}px;
    padding: 12px;
    font-size: ${FONT_SIZE_SM}px;
    font-weight: 600;
}

/* ── Settings wizard (SetupWizard QWizard pages) ─────────────────────── */
QWizard, QWizardPage {
    background-color: ${COLOR_BG_BASE};
}

QSpinBox {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_SUBTLE};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px ${SPACE_MD}px;
    min-height: 24px;
}

QSpinBox:hover {
    border-color: ${COLOR_BORDER_STRONG};
}

QSpinBox:focus {
    border: 1px solid ${COLOR_BORDER_FOCUS};
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 18px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid ${COLOR_TEXT_SECONDARY};
    width: 0;
    height: 0;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid ${COLOR_TEXT_SECONDARY};
    width: 0;
    height: 0;
}

/* Native wizard chrome buttons (Back / Next / Cancel / Finish). Scoped to
 * QWizard so intentionally styled buttons elsewhere are untouched. */
QWizard QPushButton {
    background-color: ${COLOR_BG_CARD};
    color: ${COLOR_TEXT_PRIMARY};
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_MD}px;
    padding: ${SPACE_XS}px ${SPACE_LG}px;
    min-height: 26px;
    font-weight: 600;
}

QWizard QPushButton:hover {
    background-color: ${COLOR_BG_CARD_HOVER};
    border-color: ${COLOR_TEXT_MUTED};
}

QWizard QPushButton:pressed {
    background-color: ${COLOR_BG_PANEL};
}

QWizard QPushButton:focus {
    border: 1px solid ${COLOR_BORDER_FOCUS};
}

QWizard QPushButton:default {
    background-color: ${COLOR_ACCENT_VIDEO};
    color: ${COLOR_TEXT_INVERSE};
    border-color: ${COLOR_ACCENT_VIDEO};
}

QWizard QPushButton:default:hover {
    background-color: #5FDCDC;
}

QWizard QPushButton:disabled {
    background-color: ${COLOR_BG_INPUT};
    color: ${COLOR_TEXT_MUTED};
    border-color: ${COLOR_BORDER_SUBTLE};
}

QWizard QCheckBox {
    color: ${COLOR_TEXT_PRIMARY};
    spacing: ${SPACE_SM}px;
}

QWizard QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: ${RADIUS_SM}px;
    background-color: ${COLOR_BG_INPUT};
}

QWizard QCheckBox::indicator:hover {
    border-color: ${COLOR_BORDER_FOCUS};
}

QWizard QCheckBox::indicator:checked {
    background-color: ${COLOR_ACCENT_VIDEO};
    border-color: ${COLOR_ACCENT_VIDEO};
}

QWizard QRadioButton {
    color: ${COLOR_TEXT_PRIMARY};
    spacing: ${SPACE_SM}px;
}

QWizard QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid ${COLOR_BORDER_STRONG};
    border-radius: 8px;
    background-color: ${COLOR_BG_INPUT};
}

QWizard QRadioButton::indicator:hover {
    border-color: ${COLOR_BORDER_FOCUS};
}

QWizard QRadioButton::indicator:checked {
    background-color: ${COLOR_ACCENT_VIDEO};
    border: 4px solid ${COLOR_BG_INPUT};
    outline: 1px solid ${COLOR_ACCENT_VIDEO};
}

QLabel#WizardError {
    color: ${COLOR_ACCENT_WARN};
    background: rgba(245, 176, 65, 0.08);
    border: 1px solid rgba(245, 176, 65, 0.35);
    border-radius: ${RADIUS_SM}px;
    padding: 8px 10px;
}
