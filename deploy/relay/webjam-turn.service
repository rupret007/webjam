[Unit]
Description=WebJam coturn (Always Free TURN fallback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
EnvironmentFile=/etc/webjam-turn/secret.env
ExecStart=/usr/bin/turnserver \
  -c /etc/webjam-turn/coturn.conf \
  --static-auth-secret=${TURN_STATIC_AUTH_SECRET} \
  --external-ip=${TURN_EXTERNAL_IP} \
  --listening-port=${TURN_LISTEN_PORT} \
  --min-port=${TURN_RELAY_MIN_PORT} \
  --max-port=${TURN_RELAY_MAX_PORT} \
  --realm=${TURN_REALM} \
  --pidfile /run/webjam-turn/turnserver.pid
RuntimeDirectory=webjam-turn
LogsDirectory=webjam-turn
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/webjam-turn /run/webjam-turn
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
