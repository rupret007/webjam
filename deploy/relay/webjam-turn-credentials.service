[Unit]
Description=WebJam short-lived TURN credential endpoint
After=network-online.target webjam-turn.service
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
EnvironmentFile=/etc/webjam-turn/secret.env
WorkingDirectory=/opt/webjam-turn
ExecStart=/usr/bin/python3 /opt/webjam-turn/turn_credentials.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=64M

[Install]
WantedBy=multi-user.target
