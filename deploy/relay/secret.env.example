# Copy to /etc/webjam-turn/secret.env with mode 0600.
# Never commit the real values. Never compile them into webjam-fabric.

TURN_REALM=webjam
TURN_STATIC_AUTH_SECRET=replace-with-a-long-random-secret
TURN_EXTERNAL_IP=203.0.113.10
TURN_LISTEN_PORT=3478
TURN_RELAY_MIN_PORT=49152
TURN_RELAY_MAX_PORT=49351
# Per-session cap advertised to clients. The sidecar still enforces the
# compiled 256 MiB ceiling and will only honor a lower value.
TURN_SESSION_QUOTA_BYTES=268435456
# Daily stop so Always Free outbound (10 TB/month) cannot become a bill.
# 8 GiB/day is ~240 GiB/month, well under the 10 TB Always Free allowance.
TURN_DAILY_BUDGET_BYTES=8589934592
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_LISTEN_ADDR=127.0.0.1
TURN_CREDENTIAL_PORT=8787
# Cloudflare Realtime TURN on this VM (optional switchback). Leave empty
# to mint coturn REST credentials. Preferred production path is the
# Worker in cloudflare-worker/; do not put these values in git or ldflags.
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_BASE_URL=
TURN_RATE_LIMIT_PER_MINUTE=10
